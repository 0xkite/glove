# Fails when a public header under GLOVE_INCLUDE_DIR includes Glaze.
# Usage: cmake -DGLOVE_INCLUDE_DIR=<dir> -P check_public_headers.cmake
if(NOT IS_DIRECTORY "${GLOVE_INCLUDE_DIR}")
    message(FATAL_ERROR "GLOVE_INCLUDE_DIR is not a directory: '${GLOVE_INCLUDE_DIR}'")
endif()
file(GLOB_RECURSE headers "${GLOVE_INCLUDE_DIR}/*")
list(LENGTH headers header_count)
if(header_count EQUAL 0)
    message(FATAL_ERROR "no public headers found under ${GLOVE_INCLUDE_DIR}")
endif()
set(offenders "")
foreach(header IN LISTS headers)
    file(STRINGS "${header}" hits REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]glaze/")
    if(hits)
        list(APPEND offenders "${header}")
    endif()
endforeach()
if(offenders)
    list(JOIN offenders "\n  " listed)
    message(FATAL_ERROR "public headers must not require Glaze:\n  ${listed}")
endif()
message(STATUS "${header_count} public headers checked; none requires Glaze")
