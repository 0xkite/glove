# syntax=docker/dockerfile:1.4
# Fast, cached development and test image for Glove on Linux.
#
# Provides:
#   - Clang 18 with libc++
#   - Pinned clang-format 22.1.8 (required by scripts/preflight.sh)
#   - Pinned actionlint 1.7.12 (required by scripts/preflight.sh)
#   - CMake, Ninja, pkg-config, libseccomp-dev, ccache, git, curl
#   - Container entrypoint configuring cgroup v2 controllers when available
#
# Usage:
#   docker compose run --rm dev
#   # Or directly:
#   docker build -f dockerfiles/Dockerfile.dev -t glove-dev .
#   docker run --rm -it \
#     --cap-add=SYS_ADMIN --cap-add=SETUID --cap-add=SETGID \
#     --security-opt systempaths=unconfined \
#     --security-opt seccomp=unconfined \
#     --security-opt apparmor=unconfined \
#     --cgroupns=private \
#     -v "$PWD":/glove:rw \
#     glove-dev

FROM ubuntu:24.04 AS toolchain-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang-18 clang-tidy-18 lld-18 llvm-18 \
        libclang-rt-18-dev \
        libc++-18-dev libc++abi-18-dev \
        libseccomp-dev \
        cmake ninja-build pkg-config \
        git curl jq ccache \
        python3 python3-venv \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

# Symlink clang-18 as default compiler tools
RUN ln -sf /usr/bin/clang-18 /usr/local/bin/clang \
 && ln -sf /usr/bin/clang++-18 /usr/local/bin/clang++ \
 && ln -sf /usr/bin/clang-tidy-18 /usr/local/bin/clang-tidy \
 && ln -sf /usr/bin/llvm-ar-18 /usr/local/bin/llvm-ar \
 && ln -sf /usr/bin/llvm-ranlib-18 /usr/local/bin/llvm-ranlib

# Install the required clang-format in a venv (Ubuntu 24.04 packages only 18)
RUN python3 -m venv /opt/clang-format-venv \
 && /opt/clang-format-venv/bin/pip install --no-cache-dir clang-format==23.1.1 \
 && ln -sf /opt/clang-format-venv/bin/clang-format /usr/local/bin/clang-format

# Install pinned actionlint 1.7.12
RUN ARCH="$(dpkg --print-architecture)" \
 && case "${ARCH}" in \
        amd64) AL_ARCH="amd64" ;; \
        arm64) AL_ARCH="arm64" ;; \
        *) echo "unsupported architecture for actionlint: ${ARCH}" >&2; exit 1 ;; \
    esac \
 && curl -sSLf "https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_${AL_ARCH}.tar.gz" -o /tmp/actionlint.tar.gz \
 && tar -xzf /tmp/actionlint.tar.gz -C /usr/local/bin actionlint \
 && chmod +x /usr/local/bin/actionlint \
 && rm -f /tmp/actionlint.tar.gz

ENV CC=clang
ENV CXX=clang++
ENV CXXFLAGS="-stdlib=libc++"
ENV LDFLAGS="-stdlib=libc++ -fuse-ld=lld"
ENV CCACHE_DIR=/root/.cache/ccache

COPY dockerfiles/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /glove

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/bin/bash"]
